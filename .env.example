# 복사해서 .env 로 저장한다: cp .env.example .env
# .env 는 git 에 올라가지 않는다(.gitignore). API 키는 .env 에만 넣는다.
#
# 이 파일을 읽는 쪽
# - skillops-agent(Python): 자동으로 읽는다(python-dotenv). 셸에 같은 이름이 있으면 셸 값이 이긴다.
# - service(Spring, :8080): 자동으로 읽지 않는다. 필요하면 set -a; source ../.env; set +a 후 ./gradlew bootRun.
#   비우면 application.yml 기본값을 쓴다.
# - 주문 Agent(order-agent/)는 따로 order-agent/.env 를 쓴다(order-agent/.env.example 참고).
OPENAI_API_KEY=

# docker-compose.yml 의 postgres 와 일치
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillops
POSTGRES_USER=skillops
POSTGRES_PASSWORD=skillops

# skillops-agent → service
SKILLOPS_SERVICE_URL=http://localhost:8080
SKILLOPS_MCP_URL=http://localhost:8080/mcp
SKILLOPS_MODEL=gpt-5.4-mini
# false 면 진단 노드에 RAG 참고 자료(skillops-agent/rag/rag_data.json)를 붙이지 않는다
SKILLOPS_RAG_ENABLED=true
# 고르지 않을 RAG 자료 id (쉼표로 구분). 평가할 때 같은 케이스의 사례를 뺀다
SKILLOPS_RAG_EXCLUDE=
# RAG 데이터를 만들 때 승인·반려된 제안서를 읽을 service 계정 (scripts/build_rag_data.py). 비우면 건너뛴다
SKILLOPS_RAG_SERVICE_USERNAME=
SKILLOPS_RAG_SERVICE_PASSWORD=
# true 면 service 없이 가짜 MCP 응답으로 개발한다. 실제 service(:8080)에 붙일 때 false
SKILLOPS_USE_STUB_MCP=true

# skillops-agent·service → 주문 Agent(order-agent/) 조회 API
ORDER_AGENT_BASE_URL=http://localhost:8081

# service ↔ skillops-agent 서버 간 토큰 (X-Service-Token). 두 프로세스에 같은 값을 준다. 비우면 Agent 는 검증하지 않는다.
SKILLOPS_SERVICE_TOKEN=
SKILLOPS_AGENT_URL=http://localhost:8000

# 운영 화면 로그인(JWT). 32바이트 이상. 비우면 service 가 기동마다 임시 키를 만든다(재시작 시 재로그인).
SKILLOPS_JWT_SECRET=
# 데모 계정 비밀번호를 바꾸려면 BCrypt 해시를 넣는다. 비우면 기본값 owner1234 / operator1234.
# 해시 만들기: htpasswd -bnBC 10 "" '새비밀번호' | tr -d ':\n' | sed 's/^\$2y/$2a/'
SKILLOPS_OWNER_PASSWORD_HASH=
SKILLOPS_OPERATOR_PASSWORD_HASH=

# C-2: skill·시험 주문 폴더(service/ 에서 띄울 때 기준)와 모의 실행기(contract-only | harness)
SKILLOPS_SKILLS_DIR=../skills
SKILLOPS_SCENARIOS_DIR=../scenarios
SKILLOPS_FLOW_RUNNER=contract-only
