{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apply_patch result v1.2 (#72)",
  "description": "입력 공급, 선행 단계 누락, 필수 정보 오류를 구분하는 apply_patch 성공 payload. MCP text content 내부 JSON에 적용한다.",
  "type": "object",
  "required": ["workspace_id", "changed_skills", "broken_links", "dependency_violations", "metadata_errors"],
  "properties": {
    "workspace_id": {"type": "string", "minLength": 1},
    "changed_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "version"],
        "properties": {
          "skill": {"type": "string", "pattern": "\\S"},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "broken_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "missing_input"],
        "properties": {
          "skill": {"type": "string", "pattern": "\\S"},
          "missing_input": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "dependency_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "missing_dependency"],
        "properties": {
          "skill": {"type": "string", "pattern": "\\S"},
          "missing_dependency": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "metadata_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "field", "code", "message"],
        "properties": {
          "skill": {"type": "string", "pattern": "\\S"},
          "field": {"enum": ["name", "version", "owner", "description", "body", "frontmatter"]},
          "code": {"enum": ["INVALID_SKILL_NAME", "INVALID_SKILL_FORMAT"]},
          "message": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
