{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apply_patch result v1.4 (#72, rules)",
  "description": "입력 공급, 선행 단계 누락, 필수 정보와 flow 구조 오류를 구분하는 apply_patch 성공 payload. MCP text content 내부 JSON에 적용한다. v1.4: metadata_errors.field 에 rules, flow_errors 에 CONTRACT_VIOLATION/RULE_KEY_NOT_INPUT 추가(docs/plans/2026-10-26-behavior-edit-root-fix.md 2.2).",
  "type": "object",
  "required": [
    "workspace_id",
    "changed_skills",
    "broken_links",
    "dependency_violations",
    "metadata_errors",
    "flow_errors"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "changed_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "version"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "\\S"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "broken_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "missing_input"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "\\S"
          },
          "missing_input": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "dependency_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "missing_dependency"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "\\S"
          },
          "missing_dependency": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "metadata_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "field",
          "code",
          "message"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "\\S"
          },
          "field": {
            "enum": [
              "name",
              "version",
              "owner",
              "description",
              "body",
              "frontmatter",
              "rules"
            ]
          },
          "code": {
            "enum": [
              "INVALID_SKILL_NAME",
              "INVALID_SKILL_FORMAT"
            ]
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "flow_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "code",
          "reason",
          "message"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "\\S"
          },
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "oneOf": [
          {
            "properties": {
              "code": {
                "const": "INVALID_FLOW"
              },
              "reason": {
                "enum": [
                  "EMPTY_STEPS",
                  "TOO_MANY_STEPS",
                  "DUPLICATE_STEP",
                  "INCOMPLETE_ANALYSIS"
                ]
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "UNKNOWN_SKILL"
              },
              "reason": {
                "const": "UNKNOWN_SKILL"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "INVALID_SKILL_NAME"
              },
              "reason": {
                "const": "INVALID_SKILL_NAME"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "INVALID_SKILL_FORMAT"
              },
              "reason": {
                "const": "UNREADABLE_SKILL"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "CONTRACT_VIOLATION"
              },
              "reason": {
                "enum": [
                  "NESTED_FLOW_NOT_SUPPORTED",
                  "RULE_KEY_NOT_INPUT"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
