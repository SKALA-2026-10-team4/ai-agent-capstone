{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone4.local/skillops/proposal.schema.json",
  "title": "Proposal",
  "description": "계약 4 · SkillOps Agent 가 save_proposal 로 보내는 제안서(v1). 제안서 번호·저장 시각·본문은 service 가 붙인다. 합격 판정과 근거 실행 대조도 service 가 다시 한다(계약 5 §10).",
  "type": "object",
  "required": ["trigger", "candidates", "status"],
  "properties": {
    "thread_id": { "type": ["string", "null"], "description": "진단 번호. 같은 번호로 다시 저장하면 처음 제안서를 돌려준다" },
    "trigger": { "type": "object", "description": "/diagnose 가 받은 요청 그대로" },
    "baseline_snapshot_id": { "type": ["string", "null"] },
    "snapshot_id": { "type": ["string", "null"] },
    "failure": {
      "type": ["object", "null"],
      "properties": {
        "execution_id": { "type": ["string", "null"] },
        "skill": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "missing_inputs": { "type": "array", "items": { "type": "string" } },
        "at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "root_cause": {
      "type": ["object", "null"],
      "required": ["skill", "change_no", "proof_run_ids"],
      "properties": {
        "skill": { "type": "string" },
        "change_no": { "type": "integer", "minimum": 1 },
        "hunk_id": { "type": "string" },
        "from_version": { "type": "integer" },
        "to_version": { "type": "integer" },
        "summary": { "type": "string" },
        "before": { "type": ["string", "null"] },
        "after": { "type": ["string", "null"] },
        "proof_run_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intent": {
      "type": ["object", "null"],
      "properties": {
        "text": { "type": "string" },
        "checks": { "type": "array", "items": { "type": "string" } },
        "confirmed": { "type": ["boolean", "null"], "description": "Agent 는 보내지 않는다. 승인할 때 service 가 true 로 채운다" }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_no", "kind", "patches"],
        "properties": {
          "candidate_no": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["same_skill", "linked_skills", "run_order"] },
          "workspace_id": { "type": ["string", "null"] },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["skill", "base_version", "patch"],
              "properties": {
                "skill": { "type": "string" },
                "base_version": { "type": "integer" },
                "patch": { "type": "string" }
              }
            }
          },
          "results": {
            "type": ["object", "null"],
            "properties": {
              "fixes_failure": { "type": "boolean" },
              "keeps_old_orders": {
                "type": "object",
                "required": ["passed", "total"],
                "properties": { "passed": { "type": "integer" }, "total": { "type": "integer" } }
              },
              "keeps_intent": { "type": "boolean" },
              "no_broken_links": { "type": "boolean" },
              "changed_skill_count": { "type": "integer" },
              "tools_called": { "type": "array", "items": { "type": "string" } }
            }
          },
          "valid": { "type": ["boolean", "null"] },
          "validation_error": { "type": ["string", "null"] },
          "evidence_run_ids": { "type": "array", "items": { "type": "string" } },
          "rank": { "type": ["integer", "null"] },
          "explanation": { "type": ["string", "null"] }
        }
      }
    },
    "recommended_candidate_no": { "type": ["integer", "null"], "minimum": 1 },
    "status": { "enum": ["proposed", "no_valid_fix"] }
  }
}
