{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone4.local/skillops/trace.schema.json",
  "title": "Trace",
  "description": "계약 2 · 주문 한 건의 실행 트레이스. v0 (초안). W1 이 기록하고 W2/W3/W4 가 읽는다.",
  "type": "object",
  "required": ["run_id", "order_id", "mode", "started_at", "skill_versions", "steps", "final_status"],
  "properties": {
    "run_id": { "type": "string", "pattern": "^r_[A-Za-z0-9]+$" },
    "order_id": { "type": "string" },
    "mode": { "enum": ["live", "dry-run"] },
    "workspace": { "type": ["string", "null"], "description": "dry-run 이면 ws_id, live 면 null" },
    "scenario_id": { "type": ["string", "null"], "description": "시나리오 러너가 돌린 실행이면 그 id" },
    "started_at": { "type": "string", "format": "date-time" },
    "skill_versions": {
      "type": "object",
      "description": "이 실행에 로드된 skill → version. 재현과 diff 의 기준점",
      "additionalProperties": { "type": "integer" }
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "final_status": { "enum": ["SHIPPED", "REJECTED", "HOLD", "FAILED"] }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["skill", "version", "status", "ms"],
      "properties": {
        "skill": { "type": "string" },
        "version": { "type": "integer" },
        "input": { "type": "object", "description": "이 skill 이 읽은 컨텍스트 키들 (inputs 선언 기준)" },
        "output": { "type": "object", "description": "이 skill 이 쓴 컨텍스트 키들" },
        "tools_called": { "type": "array", "items": { "type": "string" }, "description": "어댑터 tool 이름. 시나리오 기대값이 여기에 걸린다" },
        "status": { "enum": ["ok", "error", "skipped"] },
        "error": { "type": ["string", "null"], "description": "status=error 일 때 사람이 읽을 한 줄. 예: required input inventory.reserved not found" },
        "ms": { "type": "integer" }
      }
    }
  }
}
